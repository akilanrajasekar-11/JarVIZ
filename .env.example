# =============================================================
# JarVIZ — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.
# =============================================================

# ----------------------------
# Django
# ----------------------------
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------
# PostgreSQL / Neon
# Leave blank to use local SQLite (development default)
# ----------------------------
DATABASE_URL=postgresql://username:password@your-neon-host/dbname?sslmode=require

# ----------------------------
# Groq Cloud LLM
# ----------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ----------------------------
# Frontend
# ----------------------------
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----------------------------
# Optional: CCTV Integration
# ----------------------------
CCTV_API_URL=

# ----------------------------
# Optional: Redis (for Django Channels in production)
# Leave blank to use in-memory channel layer (development)
# ----------------------------
REDIS_URL=redis://localhost:6379
